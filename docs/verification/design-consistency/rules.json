  "rules": [
    {
      "id": "SORT_GROUP",
      "statement": "Sort and direction share a wrapping row",
      "rationale": "Preserve the established desktop system and the recorded task/accessibility obligation",
      "severity": "error",
      "source_ids": [
        "app-design",
        "song-controls",
        "shared-controls"
      ],
      "match": {
        "platform": "macos-web-renderer",
        "theme": "light",
        "density": "desktop",
        "role": "toolbar",
        "variant": "library-search-filters",
        "state": "paused"
      },
      "min_blocks": 1,
      "assertion": {
        "op": "one_of",
        "property": "sort_row_aligned",
        "values": [
          true
        ]
      }
    },
    {
      "id": "NAV_RESIZE_FOCUS",
      "statement": "A keyboard-focused sidebar edge has its visible neutral marker",
      "rationale": "Preserve the established desktop system and the recorded task/accessibility obligation",
      "severity": "error",
      "source_ids": [
        "app-design",
        "focus",
        "navigation"
      ],
      "match": {
        "platform": "macos-web-renderer",
        "theme": "light",
        "density": "desktop",
        "role": "navigation",
        "variant": "music-sidebar",
        "state": "keyboard-focus"
      },
      "min_blocks": 1,
      "assertion": {
        "op": "one_of",
        "property": "resize_focus_marker_visible",
        "values": [
          true
        ]
      }
    },
    {
      "id": "QUEUE_TARGET_WIDTH",
      "statement": "Queue move and grip targets have compact widths of 24 to 32 CSS px",
      "rationale": "Preserve the established desktop system and the recorded task/accessibility obligation",
      "severity": "error",
      "source_ids": [
        "app-design",
        "targets",
        "queue"
      ],
      "match": {
        "platform": "macos-web-renderer",
        "theme": "light",
        "density": "desktop",
        "role": "list",
        "variant": "listening-queue",
        "state": "paused"
      },
      "min_blocks": 1,
      "assertion": {
        "op": "range",
        "property": "queue_control_min_width",
        "min": 24,
        "max": 32
      }
    },
    {
      "id": "QUEUE_TARGET_HEIGHT",
      "statement": "Queue move and grip targets have compact heights of 24 to 32 CSS px",
      "rationale": "Preserve the established desktop system and the recorded task/accessibility obligation",
      "severity": "error",
      "source_ids": [
        "app-design",
        "targets",
        "queue"
      ],
      "match": {
        "platform": "macos-web-renderer",
        "theme": "light",
        "density": "desktop",
        "role": "list",
        "variant": "listening-queue",
        "state": "paused"
      },
      "min_blocks": 1,
      "assertion": {
        "op": "range",
        "property": "queue_control_min_height",
        "min": 24,
        "max": 32
      }
    },
    {
      "id": "PLAYER_FRAME",
      "statement": "The measured player frame fits this viewport",
      "rationale": "Preserve the established desktop system and the recorded task/accessibility obligation",
      "severity": "error",
      "source_ids": [
        "app-design",
        "shared-controls"
      ],
      "match": {
        "platform": "macos-web-renderer",
        "theme": "light",
        "density": "desktop",
        "role": "action-group",
        "variant": "music-transport",
        "state": "paused"
      },
      "min_blocks": 1,
      "assertion": {
        "op": "contained"
      }
    },
    {
      "id": "TABLE_RHYTHM",
      "statement": "Virtual song rows retain their existing 56 CSS px rhythm",
      "rationale": "Preserve the established desktop system and the recorded task/accessibility obligation",
      "severity": "error",
      "source_ids": [
        "app-design",
        "shared-controls"
      ],
      "match": {
        "platform": "macos-web-renderer",
        "theme": "light",
        "density": "desktop",
        "role": "table",
        "variant": "songs-visible-viewport",
        "state": "paused"
      },
      "min_blocks": 1,
      "assertion": {
        "op": "one_of",
        "property": "row_height",
        "values": [
          56
        ]
      }
    }
  ]
}

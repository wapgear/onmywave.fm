{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "node"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "jsx-a11y/prefer-tag-over-role": "off",
    "import/first": "error",
    "import/no-duplicates": "error",
    "react/jsx-key": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-danger": "error",
    "react/no-children-prop": "error",
    "react/no-direct-mutation-state": "error"
  },
  "overrides": [
    {
      "files": [
        "src/renderer/components/AddPlaylist/AddPlaylist.component.tsx",
        "src/renderer/pages/Connection/Connection.page.tsx",
        "src/renderer/pages/Sources/Sources.page.tsx",
        "src/renderer/pages/Playlists/Playlists.page.tsx",
        "src/renderer/pages/Stations/Stations.page.tsx"
      ],
      "rules": {
        "jsx-a11y/no-autofocus": "off"
      }
    },
    {
      "files": [
        "src/renderer/components/FilterSelect/FilterSelect.component.tsx",
        "src/renderer/components/TrackTable/TrackTable.component.tsx",
        "src/renderer/components/Shared.tsx"
      ],
      "rules": {
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    },
    {
      "files": ["src/renderer/components/Shared.tsx"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off"
      }
    },
    {
      "files": ["src/renderer/pages/DJs/components/VoicePreview.component.tsx"],
      "rules": {
        "jsx-a11y/media-has-caption": "off"
      }
    }
  ],
  "extends": ["./.oxlint-spacing.json"]
}

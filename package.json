{
  "name": "onmywave-desktop",
  "version": "0.5.2",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "onmywave.fm contributors",
  "description": "A macOS music player for your Jellyfin library",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron && node scripts/install-git-hooks.mjs",
    "dev": "electron-vite dev",
    "build": "node scripts/prepare-voice-previews.mjs --check && pnpm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings=0",
    "package:mac": "pnpm run build && electron-builder --mac --dir --publish never",
    "format": "oxfmt --write . && oxlint --fix --config .oxlint-format.json",
    "format:check": "oxfmt --check . && oxlint --config .oxlint-format.json --max-warnings=0",
    "check": "pnpm run format:check && pnpm run lint && pnpm run build",
    "release:mac": "bash scripts/release-mac.sh",
    "hooks:install": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@tanstack/react-query": "5.96.2",
    "@tanstack/react-virtual": "^3.14.19",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24.13.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.8.1",
    "electron-builder": "^26.15.7",
    "electron-vite": "6.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^4.3.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^5.9.3",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "fm.onmywave.light",
    "productName": "onmywave.fm",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dir"
      ],
      "icon": "resources/icon.icns"
    },
    "artifactName": "onmywave-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "wapgear",
      "repo": "onmywave-app"
    }
  },
  "homepage": "https://github.com/wapgear/onmywave.fm#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wapgear/onmywave.fm.git"
  },
  "bugs": {
    "url": "https://github.com/wapgear/onmywave.fm/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.34.7"
}

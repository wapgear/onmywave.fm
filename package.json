{
  "name": "onmywave-desktop",
  "version": "0.8.4",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "onmywave.fm contributors",
  "description": "A desktop music player for your Jellyfin library",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron && node scripts/install-git-hooks.mjs",
    "dev": "electron-vite dev",
    "build": "node scripts/prepare-voice-previews.mjs --check && pnpm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings=0",
    "package:mac": "pnpm run build && electron-builder --mac --arm64 --publish never && node scripts/verify-packaged-updates.mjs release/mac-arm64/onmywave.fm.app",
    "format": "oxfmt --write . && oxlint --fix --config .oxlint-format.json",
    "format:check": "oxfmt --check . && oxlint --config .oxlint-format.json --max-warnings=0",
    "check": "pnpm run format:check && pnpm run lint && pnpm run build",
    "release:mac": "bash scripts/release-mac.sh",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "package:linux": "pnpm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/ai": "1.2.0",
    "@tanstack/ai-openai": "^1.1.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.0",
    "iconoir-react": "7.12.2",
    "linkedom": "^0.18.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "^0.28.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.5.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "rolldown": "~1.3.0",
    "typescript": "^7.0.2",
    "vite": "8.3.6"
  },
  "build": {
    "appId": "fm.onmywave.light",
    "productName": "onmywave.fm",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/icon.png",
      "resources/trayTemplate*.png",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "zip"
      ],
      "icon": "resources/icon.icns"
    },
    "artifactName": "onmywave-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "wapgear",
      "repo": "onmywave-app"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "resources/icon.png",
      "artifactName": "onmywave-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true
    }
  },
  "homepage": "https://github.com/wapgear/onmywave.fm#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wapgear/onmywave.fm.git"
  },
  "bugs": {
    "url": "https://github.com/wapgear/onmywave.fm/issues"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@10.34.7",
  "desktopName": "onmywave.fm.desktop"
}

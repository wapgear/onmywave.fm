{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "out/**",
    "release/**",
    "node_modules/**",
    "docs/**",
    "resources/**",
    "pnpm-lock.yaml",
    "*.md",
    "LICENSE",
    "src/renderer/public/**"
  ],
  "sortImports": {
    "groups": ["builtin", "external", ["internal", "subpath"], ["parent", "sibling", "index"], "style", "unknown"],
    "newlinesBetween": true,
    "sortSideEffects": false
  }
}
